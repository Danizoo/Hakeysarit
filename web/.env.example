# Copy to .env and fill in after creating the Sanity project.
# Leave SANITY_PROJECT_ID empty to run on the built-in sample content.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Optional. A write token lets the build cache resolved map coordinates back
# into Sanity, so each restaurant is geocoded once and never again.
SANITY_WRITE_TOKEN=

# Used for canonical URLs and sitemap. Set this on Vercel to the real domain.
SITE_URL=https://hakeysarit.vercel.app
