---
import { formatScore, scoreBand } from '../lib/format';

interface Props {
  score: number;
  size?: 'sm' | 'md' | 'lg';
  showLabel?: boolean;
  class?: string;
}

const { score, size = 'md', showLabel = false, class: className = '' } = Astro.props;
const band = scoreBand(score);

const dimensions = {
  sm: 'h-11 w-11 text-base',
  md: 'h-14 w-14 text-xl',
  lg: 'h-20 w-20 text-3xl',
}[size];
---

<div class:list={['flex items-center gap-2.5', className]}>
  <div
    class:list={[
      'grid shrink-0 place-items-center rounded-full font-display font-bold text-white tabular-nums shadow-sm',
      dimensions,
    ]}
    style={`background:${band.bg}`}
  >
    <span aria-hidden="true">{formatScore(score)}</span>
    <span class="sr-only">{`ציון ${formatScore(score)} מתוך 10 — ${band.label}`}</span>
  </div>
  {
    showLabel && (
      <span class="font-display text-sm font-bold sm:text-base" style={`color:${band.fg}`}>
        {band.label}
      </span>
    )
  }
</div>
