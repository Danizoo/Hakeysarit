---
/** The mark: a laurel wreath (Caesar) around a salad bowl.
 *  Leaves are placed along two mirrored arcs so they stay evenly spaced. */

interface Props {
  size?: number;
  class?: string;
}

const { size = 40, class: className = '' } = Astro.props;

const cx = 24;
const cy = 24.5;
const radius = 17.5;
const leafCount = 6;

type Leaf = { x: number; y: number; angle: number; scale: number };

function branch(direction: 1 | -1): Leaf[] {
  const leaves: Leaf[] = [];
  for (let i = 0; i < leafCount; i++) {
    const t = i / (leafCount - 1);
    // Sweep from the bottom of the circle up to the "open" gap at the top.
    const degrees = 96 - t * 148;
    const radians = (degrees * Math.PI) / 180;
    leaves.push({
      x: cx + direction * radius * Math.cos(radians),
      y: cy + radius * Math.sin(radians),
      angle: direction * (90 - degrees) + (direction === 1 ? 28 : -28),
      scale: 0.72 + 0.28 * (1 - Math.abs(t - 0.45) * 1.2),
    });
  }
  return leaves;
}

const leaves = [...branch(1), ...branch(-1)];
const arc = (direction: 1 | -1) => {
  const start = { x: cx + direction * radius * Math.cos((96 * Math.PI) / 180), y: cy + radius * Math.sin((96 * Math.PI) / 180) };
  const end = { x: cx + direction * radius * Math.cos((-52 * Math.PI) / 180), y: cy + radius * Math.sin((-52 * Math.PI) / 180) };
  return `M ${start.x.toFixed(2)} ${start.y.toFixed(2)} A ${radius} ${radius} 0 0 ${direction === 1 ? 0 : 1} ${end.x.toFixed(2)} ${end.y.toFixed(2)}`;
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  role="img"
  aria-hidden="true"
  class={className}
>
  <path d={arc(1)} stroke="currentColor" stroke-width="1.3" stroke-linecap="round" opacity="0.55" />
  <path d={arc(-1)} stroke="currentColor" stroke-width="1.3" stroke-linecap="round" opacity="0.55" />

  {
    leaves.map((leaf) => (
      <ellipse
        cx="0"
        cy="0"
        rx="4.6"
        ry="2.15"
        fill="currentColor"
        transform={`translate(${leaf.x.toFixed(2)} ${leaf.y.toFixed(2)}) rotate(${leaf.angle.toFixed(1)}) scale(${leaf.scale.toFixed(2)})`}
      />
    ))
  }

  <!-- bowl -->
  <path
    d="M14.5 21.5 h19 a1 1 0 0 1 1 1 c0 5.8 -4.6 10.2 -10.5 10.2 s-10.5 -4.4 -10.5 -10.2 a1 1 0 0 1 1 -1 z"
    fill="currentColor"
    opacity="0.92"
  />
  <path
    d="M16.8 25.6 h14.4"
    stroke="var(--color-cream, #faf6ec)"
    stroke-width="1.4"
    stroke-linecap="round"
    opacity="0.5"
  />
</svg>
